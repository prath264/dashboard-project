# ==============================================================================
# Visitor Management System - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control - it contains secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# Microsoft Graph (MSAL Client Credentials Flow)
# ------------------------------------------------------------------------------
# Register an App in Azure AD (Microsoft Entra ID) with:
# - Application permissions: User.Read.All, Mail.Send
# - Grant admin consent for your tenant
# - Create a client secret
# - Use a service account mailbox for sending emails
# ------------------------------------------------------------------------------

# Azure AD App (Client) ID
MS_CLIENT_ID=your-app-client-id-here

# Azure AD Tenant (Directory) ID
MS_TENANT_ID=your-tenant-id-here

# Azure AD App Client Secret (create in App Registration > Certificates & secrets)
MS_CLIENT_SECRET=your-client-secret-here

# Mailbox email address used to SEND host notification emails via Graph sendMail
# Must be a valid mailbox in your tenant that the app has Mail.Send permission for
MS_SERVICE_ACCOUNT_EMAIL=notifications@yourdomain.com

# ------------------------------------------------------------------------------
# Microsoft Graph API Settings (usually don't need to change these)
# ------------------------------------------------------------------------------
# OAuth scope for Graph API (default is correct for most cases)
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Graph API base URL (default is correct for global cloud)
# Change only for sovereign clouds (e.g., Graph China, Graph US Gov)
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# ------------------------------------------------------------------------------
# Database (SQLite - file-based, no separate server needed)
# ------------------------------------------------------------------------------
# Database URL - uses SQLite by default. For PostgreSQL/MySQL, use:
# postgresql://user:pass@host:5432/dbname
# mysql://user:pass@host:3306/dbname
# DATABASE_URL=sqlite:///./visitors.db

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload directory for visitor selfies (relative to backend root)
# UPLOAD_DIR=uploads